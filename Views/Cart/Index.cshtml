@model List<CoolCompanyEstore.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    // قم بحساب الإجمالي مرة واحدة هنا
    decimal total = Model.Sum(item => (item.Product?.Price ?? 0) * item.Quantity);
}

<style>
    /* تنسيق خاص للأجهزة المحمولة فقط */
    @@media (max-width: 767px) {
        .page-padding-top {
            padding-top: 20px !important;
        }

        .shopping-cart-item-card {
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-radius: .5rem;
            box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075);
            margin-bottom: 1rem;
            padding: 1rem;
        }

        .item-details {
            font-size: 0.9rem;
        }

            .item-details strong {
                display: block;
                margin-bottom: 0.25rem;
                font-size: 1rem;
            }

        .item-image {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 0.5rem;
            border: 1px solid #eee;
        }

        .quantity-form {
            margin-top: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .quantity-input {
            width: 60px;
            text-align: center;
        }

        .remove-btn {
            margin-top: 0.5rem;
        }
        /* إخفاء الجدول على الهاتف */
        .table-responsive {
            display: none;
        }

        .cart-summary {
            font-size: 1.5rem !important;
        }

        .footer-bank-card img {
            width: 40px !important;
            height: auto !important;
        }
            /* زيادة حجم أيقونات STC Pay و Mada على الهاتف */
            .footer-bank-card img[alt="STC Pay"] {
                width: 60px !important;
            }

            .footer-bank-card img[alt="Mada"] {
                width: 60px !important;
            }
    }
</style>

<div class="d-flex justify-content-center mb-4 page-padding-top">
    <div class="bg-light text-center p-4 rounded-3 shadow-sm" style="max-width: 500px; width: 100%;">
        <div class="d-flex align-items-center justify-content-center mb-3">
            <img src="@Url.Content(ViewBag.ProfileImageUrl ?? "~/img/default-user.png")"
                 alt="Profile Image"
                 width="80" height="80"
                 class="rounded-circle border border-2 shadow" />
        </div>
        <h5 class="mb-1 text-primary fw-bold">@ViewBag.UserName</h5>
        <p class="text-muted small mb-0">Welcome back to your cart</p>
    </div>
</div>

@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["CartMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["OrderSuccessMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["OrderSuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container">
    @if (Model == null || !Model.Any())
    {
        <div class="d-flex justify-content-center">
            <div class="alert alert-primary text-center p-3 rounded-3 shadow-sm" style="max-width: 400px;">
                <div class="mb-2">
                    Your cart is empty.
                </div>
                <a href="/Products" class="btn btn-outline-primary d-inline-flex align-items-center shadow-sm">
                    <i class="fa fa-store me-2"></i> Shop Now
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="my-5 shadow rounded p-4 bg-white">

            <h2 class="mb-4">Your Shopping Cart</h2>

            <div class="d-block d-md-none">
                @foreach (var item in Model)
                {
                    var price = item.Product?.Price ?? 0m;
                    var subtotal = price * item.Quantity;

                    <div class="shopping-cart-item-card">
                        <div class="d-flex align-items-center mb-3">
                            <img src="@Url.Content(item.Product?.Images?.FirstOrDefault()?.ImagePath ?? "/img/default-product.jpg")"
                                 alt="Product Image"
                                 class="item-image me-3" />
                            <div class="flex-grow-1 item-details">
                                <strong>@(item.Product?.Name ?? "Unknown Product")</strong>
                                <span>Color: @item.SelectedColor | Size: @item.SelectedSize</span><br />
                                <span>Price: @price.ToString("0.00") SAR</span><br />
                                <span>Subtotal: @subtotal.ToString("0.00") SAR</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-danger shadow-sm remove-btn" onclick="return confirm('Are you sure you want to remove this item?')">
                                    🗑 Remove
                                </button>
                            </form>
                            <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" class="d-flex align-items-center">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-2 border shadow-sm quantity-input" />
                                <button type="submit" class="btn btn-sm btn-outline-primary shadow-sm">Update</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="table-responsive d-none d-md-block">
                <table class="table table-bordered table-hover border rounded shadow-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Color</th>
                            <th>Size</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var price = item.Product?.Price ?? 0m;
                            var subtotal = price * item.Quantity;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@Url.Content(item.Product?.Images?.FirstOrDefault()?.ImagePath ?? "/img/default-product.jpg")"
                                             alt="Product Image"
                                             width="50"
                                             class="me-2 rounded shadow-sm border" />
                                        <span>@(item.Product?.Name ?? "Unknown Product")</span>
                                    </div>
                                </td>
                                <td>@item.SelectedColor</td>
                                <td>@item.SelectedSize</td>
                                <td>@price.ToString("0.00") SAR</td>
                                <td>
                                    <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" class="d-flex">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-1 border shadow-sm" style="width: 70px;" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary shadow-sm">Update</button>
                                    </form>
                                </td>
                                <td>@subtotal.ToString("0.00") SAR</td>
                                <td>
                                    <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger shadow-sm" onclick="return confirm('Are you sure you want to remove this item?')">
                                            🗑 Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center text-center text-md-end mt-4 pt-3 border-top">
                <div class="w-100">
                    <h4 class="cart-summary">Total: <span class="text-success">@total.ToString("0.00") SAR</span></h4>
                    <div class="d-flex flex-column flex-md-row justify-content-center justify-content-md-end gap-2 mt-3">
                        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-secondary shadow-sm">
                            <i class="fa fa-box"></i> View My Orders
                        </a>
                        <a href="/Checkout" class="btn btn-success shadow">Proceed to Checkout</a>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-block d-md-none text-center">
                <h5>We Accept</h5>
                <div class="footer-bank-card d-flex gap-3 justify-content-center mt-2">
                    <a href="/Checkout" class="me-3 mb-2"><img src="~/img/apple-pay.jpg" alt="Apple Pay" width="50" height="30" /></a>
                    <a href="/Checkout" class="me-3 mb-2"><img src="~/img/STC.jpg" alt="STC Pay" width="90" height="40" /></a>
                    <a href="/Checkout" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" alt="Visa" width="50" height="30" /></a>
                    <a href="/Checkout" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="MasterCard" width="50" height="30" /></a>
                    <a href="/Checkout" class="me-3 mb-2"><img src="~/img/Mada.jpg" alt="Mada" width="60" height="45" /></a>
                </div>
            </div>

            <div class="mt-4 d-none d-md-block">
                <h5>We Accept</h5>
                <div class="d-flex gap-3 mt-2">
                    <div class="footer-bank-card d-flex align-items-center flex-wrap">
                        <a href="/Checkout" class="me-3 mb-2"><img src="~/img/apple-pay.jpg" alt="Apple Pay" width="50" height="30" /></a>
                        <a href="/Checkout" class="me-3 mb-2"><img src="~/img/STC.jpg" alt="STC Pay" width="90" height="43" /></a>
                        <a href="/Checkout" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" alt="Visa" width="50" height="30" /></a>
                        <a href="/Checkout" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="MasterCard" width="50" height="30" /></a>
                        <a href="/Checkout" class="me-3 mb-2"><img src="~/img/Mada.jpg" alt="Mada" width="63" height="45" /></a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

