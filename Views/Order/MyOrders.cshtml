@using System.Linq
@model List<CoolCompanyEstore.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-5 page-padding-top">
    <h2 class="mb-4">🧾 My Orders</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You haven't placed any orders yet.
            <a href="/Products" class="btn btn-outline-primary mt-3">Shop Now</a>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            string statusClass = order.Status switch
            {
                "Delivered" => "badge bg-success",
                "Processing" => "badge bg-warning text-dark",
                "Canceled" => "badge bg-danger",
                _ => "badge bg-secondary"
            };

            <div class="card mb-4 shadow-sm border border-primary rounded-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Order ID:</strong> @order.Id <br />
                        <strong>Date:</strong> @order.OrderDate.ToString("yyyy-MM-dd") <br />
                        <strong>Total:</strong> @order.TotalAmount.ToString("0.00") SAR
                    </div>
                    <span class="@statusClass">@order.Status</span>
                </div>

                <div class="card-body">
                    <h6 class="mb-3">Items:</h6>
                    @foreach (var item in order.Items)
                    {
                        <div class="d-flex mb-3 align-items-center border rounded p-2">
                            <!-- تم التعديل هنا: استخدام أول صورة من قائمة صور المنتج -->
                            <img src="@(item.Product?.Images.FirstOrDefault()?.ImagePath ?? "/img/default-product.jpg")"
                                 alt="@item.ProductName"
                                 style="max-width: 100px; max-height: 100px; object-fit: cover;"
                                 class="me-3 rounded border" />

                            <div class="flex-grow-1">
                                <strong>@item.ProductName</strong><br />
                                Quantity: @item.Quantity<br />
                                Price: @item.Price.ToString("0.00") SAR<br />
                                Color: @item.SelectedColor | Size: @item.SelectedSize
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
