@model CoolCompanyEstore.Models.HomeViewModel
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home";
}

<div class="carousel-header">
    <div id="carouselId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-inner" role="listbox">
            @for (int i = 0; i < Model.CarouselImages.Count; i++)
            {
                var item = Model.CarouselImages[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Url.Action("GetCarouselImage", "CarouselAdmin", new { id = item.Id })" class="img-fluid w-100" alt="@item.Title" />
                    <div class="carousel-caption d-flex flex-column align-items-center justify-content-center h-100 top-0 start-0 w-100">
                        <div class="p-3 text-center" style="max-width: 900px;">
                            <h4 class="text-white text-uppercase fw-bold mb-4">@item.Title</h4>
                            <h1 class="display-2 text-capitalize text-white mb-4">@item.Subtitle</h1>
                            <p class="mb-5 fs-5">@item.Description</p>
                            <a class="btn btn-primary rounded-pill py-3 px-5" href="@item.ButtonLink">@item.ButtonText</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
            <span class="carousel-control-prev-icon btn bg-primary" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
            <span class="carousel-control-next-icon btn bg-primary" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<div class="container my-5">
    <h2 class="mb-4">Our Products</h2>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-3">
            <input name="search" class="form-control" placeholder="Search by name" value="@Context.Request.Query["search"]" />
        </div>
        <div class="col-md-2">
            <input name="minPrice" class="form-control" placeholder="Min Price" value="@Context.Request.Query["minPrice"]" />
        </div>
        <div class="col-md-2">
            <input name="maxPrice" class="form-control" placeholder="Max Price" value="@Context.Request.Query["maxPrice"]" />
        </div>
        <div class="col-md-2">
            <input name="color" class="form-control" placeholder="Color" value="@Context.Request.Query["color"]" />
        </div>
        <div class="col-md-2">
            <input name="size" class="form-control" placeholder="Size M,L,S.." value="@Context.Request.Query["size"]" />
        </div>
        <div class="col-md-1">
            <button class="btn btn-primary w-100">Filter</button>
        </div>
    </form>

    <div class="row g-4">
        @if (Model?.FilteredProducts != null && Model.FilteredProducts.Any())
        {
            foreach (var product in Model.FilteredProducts)
            {
                <!-- هنا تم التعديل -->
                <div class="col-4 col-md-3">
                    <a href="/Products/Details/@product.Id" class="text-decoration-none text-dark">
                        <div class="card shadow-lg border-0 rounded card-zoom">
                            @if (product.Images != null && product.Images.Any())
                            {
                                <div id="productCarouselHome-@product.Id" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        @{ var isFirst = true; }
                                        @foreach (var image in product.Images)
                                        {
                                            <div class="carousel-item @(isFirst ? "active" : "") overflow-hidden">
                                                <img src="@image.ImagePath" class="d-block w-100 rounded-top" style="object-fit: cover; max-height: 200px;" alt="@product.Name - Image">
                                            </div>
                                            isFirst = false;
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="overflow-hidden">
                                    <img src="/img/default-product.jpg" class="card-img-top rounded-top" alt="@product.Name" style="object-fit: cover; max-height: 200px;" />
                                </div>
                            }
                            <div class="card-body">
                                <h5 class="card-title text-primary fw-bold">@product.Name</h5>
                                <p class="card-text text-muted" style="min-height: 3rem;">@product.Description</p>
                                <p class="fw-bold text-primary">@product.Price.ToString("C")</p>
                                <a href="/Products/Details/@product.Id" class="btn btn-outline-primary btn-sm shadow-sm">View</a>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No products found.</p>
        }
    </div>
</div>
