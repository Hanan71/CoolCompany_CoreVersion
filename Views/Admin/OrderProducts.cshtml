@using CoolCompanyEstore.Models
@using System.Linq

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Order Products";
}

<div class="container mt-5 page-padding-top">
    <h2> Check Orders 🧾</h2>

    <div class="table-responsive shadow rounded d-none d-md-block">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="custom-gray-header table-secondary">
                <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Total Amount</th>
                    <th>Items Count</th>
                    <th>Products</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@order.Status</td>
                        <td>@order.TotalAmount.ToString("0.00") SAR</td>
                        <td>@order.Items?.Count</td>
                        <td>
                            <ul class="list-unstyled">
                                @foreach (var item in order.Items)
                                {
                                    <li class="mb-2 text-start">
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(((IEnumerable<CoolCompanyEstore.Models.ProductImage>)item.Product?.Images)?.FirstOrDefault()?.ImagePath ?? "/img/default-product.jpg")"
                                                 alt="@item.ProductName"
                                                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;" />
                                            <div>
                                                🛒 <strong>@item.ProductName</strong><br />
                                                Quantity: @item.Quantity<br />
                                                Price: @item.Price.ToString("0.00") SAR<br />
                                                Color: @item.SelectedColor | Size: @item.SelectedSize
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none">
        @foreach (var order in Model)
        {
            <div class="card shadow border-0 mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary">Order ID: @order.Id</h5>
                    <p class="card-text mb-1">
                        <strong>Date:</strong> @order.OrderDate.ToString("yyyy-MM-dd")
                    </p>
                    <p class="card-text mb-1">
                        <strong>Status:</strong> @order.Status
                    </p>
                    <p class="card-text mb-1">
                        <strong>Total Amount:</strong> @order.TotalAmount.ToString("0.00") SAR
                    </p>
                    <p class="card-text mb-2">
                        <strong>Items Count:</strong> @order.Items?.Count
                    </p>

                    <h6 class="mt-3">Products:</h6>
                    <ul class="list-unstyled">
                        @foreach (var item in order.Items)
                        {
                            <li class="mb-3 text-start border-top pt-3">
                                <div class="d-flex align-items-start gap-2">
                                    <img src="@(((IEnumerable<CoolCompanyEstore.Models.ProductImage>)item.Product?.Images)?.FirstOrDefault()?.ImagePath ?? "/img/default-product.jpg")"
                                         alt="@item.ProductName"
                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;" />
                                    <div>
                                        <strong>@item.ProductName</strong><br />
                                        Quantity: @item.Quantity<br />
                                        Price: @item.Price.ToString("0.00") SAR<br />
                                        <small class="text-muted">Color: @item.SelectedColor | Size: @item.SelectedSize</small>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary">
            ← Back to Orders
        </a>
    </div>
</div>

