@using Microsoft.AspNetCore.Identity
@model List<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Roles";
}

<div class="container mt-5">
    <h2> Manage Roles⚔️</h2>

    <div class="table-responsive shadow rounded">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="custom-gray-header table-secondary">
                <tr>
                    <th>Role Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>
                            <form method="post" asp-action="DeleteRole" asp-controller="Admin" style="display:inline;">
                                <input type="hidden" name="roleId" value="@role.Id" />
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this role?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <hr />
    <h4>Add New Role</h4>
    <div class="shadow p-3 rounded">
        <form method="post" asp-action="CreateRole" asp-controller="Admin" class="form-inline mt-3">
            <div class="form-group">
                <input type="text" name="roleName" class="form-control me-2" placeholder="Enter role name" required />
            </div>
            <button type="submit" class="btn btn-primary">Add Role</button>
        </form>
    </div>


    <h4>Add New Role</h4>
    <div class="shadow p-3 rounded">
        <form method="post" asp-action="CreateRoleWithPages" asp-controller="Admin" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Role Name</label>
                <input type="text" name="roleName" class="form-control" placeholder="Enter role name" required />
            </div>

            <label class="form-label">Select pages to allow for this role:</label>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="pages" value="Dashboard" />
                <label class="form-check-label">Dashboard</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="pages" value="Products" />
                <label class="form-check-label">Products</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="pages" value="Orders" />
                <label class="form-check-label">Orders</label>
            </div>
            <!-- أضف صفحات حسب ما تحتاج -->

            <button type="submit" class="btn btn-primary mt-3">Add Role</button>
        </form>
    </div>

    <div class="sidebar">
        <h3>Admin Panel</h3>


    <div class="text-center mt-4">
        <a asp-controller="Admin" asp-action="SuperDashboard" class="btn btn-outline-primary">
            ← Back to Dashboard
        </a>
    </div>
