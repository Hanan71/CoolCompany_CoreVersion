@model CoolCompanyEstore.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Login</h2>

<!-- عرض الأخطاء من ModelState -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<!-- عرض رسالة تسجيل الحساب الجديد في حالة عدم وجود المستخدم -->
@if (TempData["RegisterSuggestion"] != null)
{
    <div class="alert alert-warning text-center">
        @TempData["RegisterSuggestion"]
        <br />
        <a asp-controller="Account" asp-action="RegisterUser" class="btn btn-outline-primary mt-2">
            Create a new account, click on Register
        </a>
    </div>
}



<div class="container mt-5">
    <h2 class="mb-4">Login</h2>

    <form asp-action="Login" method="post">
        <div class="mb-3 border rounded shadow-sm p-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3 border rounded shadow-sm p-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3 border rounded shadow-sm p-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
        </div>

        <button type="submit" class="btn btn-primary">Login</button>
    </form>

    <p class="mt-3">
        Don't have an account? <a asp-controller="Account" asp-action="RegisterUser">Register here</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
