@model CoolCompanyEstore.Models.CarouselAdminViewModel

@{
    ViewData["Title"] = "Manage Carousel";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="container mt-5">
    <h2 class="mb-4">Add New Carousel Slide 🔖</h2>

    <div class="card shadow-lg rounded border-0 p-4">
        <form asp-action="Save" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="NewSlide.ImageData" class="form-label">Background Image (important never work without it)</label>
                <input type="file" name="ImageFile" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.Title" class="form-label"></label>
                <input asp-for="NewSlide.Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.ShortParagraph" class="form-label"></label>
                <textarea asp-for="NewSlide.ShortParagraph" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.ButtonLabel" class="form-label"></label>
                <input asp-for="NewSlide.ButtonLabel" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.ButtonLink" class="form-label"></label>
                <input asp-for="NewSlide.ButtonLink" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.Subtitle" class="form-label"></label>
                <input asp-for="NewSlide.Subtitle" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.Description" class="form-label"></label>
                <textarea asp-for="NewSlide.Description" class="form-control"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.ButtonText" class="form-label"></label>
                <input asp-for="NewSlide.ButtonText" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="NewSlide.DisplayOrder" class="form-label"></label>
                <input asp-for="NewSlide.DisplayOrder" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Add Slide</button>
        </form>
    </div>

    @if (Model.Slides.Any())
    {
        <h2 class="mt-5">Existing Slides</h2>
        <div class="row">
            @foreach (var slide in Model.Slides)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-lg border-0 rounded">
                        <img class="card-img-top rounded-top"
                             src="@Url.Action("GetCarouselImage", "CarouselAdmin", new { id = slide.Id })"
                             alt="@slide.Title" />
                        <div class="card-body">
                            <h5 class="card-title text-primary fw-bold">@slide.Title</h5>
                            <p class="card-text text-muted">@slide.ShortParagraph</p>

                            <div class="d-flex justify-content-between">
                                <a asp-action="Edit" asp-route-id="@slide.Id" class="btn btn-warning me-2">Edit</a>

                                <form asp-action="Delete" method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this slide?');">
                                    <input type="hidden" name="id" value="@slide.Id" />
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <script>
    @if (TempData["SuccessMessage"] != null)
    {
        <text>toastr.info('@TempData["SuccessMessage"]');</text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>toastr.info('@TempData["ErrorMessage"]');</text>
    }

        //  التنبيه عند عدم رفع صورة
        document.querySelector('form').addEventListener('submit', function (e) {
            var fileInput = document.querySelector('input[name="ImageFile"]');

            if (!fileInput.value) {
                e.preventDefault(); // يمنع إرسال النموذج
                toastr.error("You didn't add a picture");
            }
        });
    </script>
}

<div class="text-center mt-4">
    <button onclick="history.back()" class="btn btn-outline-primary">
        ← Back to Previous Page
    </button>
</div>