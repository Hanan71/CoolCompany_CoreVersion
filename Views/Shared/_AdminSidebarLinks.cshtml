@using Microsoft.AspNetCore.Identity
@using CoolCompanyEstore.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<h3 class="mt-3">Admin Panel</h3>
<a href="@Url.Action("Index", "Home")" class="offcanvas-link @( (ViewContext.RouteData.Values["controller"]?.ToString() ?? "") == "Home" ? "active" : "")">
    <i class="fa fa-home me-2"></i> Home
</a>
<a href="@Url.Action("Index", "Cart")" class="offcanvas-link @( (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "Cart" ? "active" : "")">
    <i class="fa fa-user me-2"></i> Profile
</a>

@if (User.IsInRole("SuperAdmin"))
{
    <a href="@Url.Action("SuperDashboard", "Admin")" class="offcanvas-link @( (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "SuperDashboard" ? "active" : "")">
        <i class="fa fa-tachometer-alt me-2"></i> Manage Status
    </a>
    <a href="@Url.Action("Orders", "Admin")" class="offcanvas-link @( (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "Orders" ? "active" : "")">
        <i class="fa fa-shopping-cart me-2"></i> Manage Orders
    </a>
    <a href="@Url.Action("ManageUsers", "Admin")" class="offcanvas-link @( (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "ManageUsers" ? "active" : "")">
        <i class="fa fa-users me-2"></i> Manage Users
    </a>
    <a href="@Url.Action("Register", "Account", new { area = "Admin" })"
       class="offcanvas-link @( (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "Register" ? "active" : "")">
        <i class="fa fa-user-plus me-2"></i> Register New Admin
    </a>
}

@if (User.IsInRole("SuperAdmin") || User.IsInRole("ContentManager"))
{
    <a href="@Url.Action("Index", "CarouselAdmin")" class="offcanvas-link @( (ViewContext.RouteData.Values["controller"]?.ToString() ?? "") == "CarouselAdmin" ? "active" : "")">
        <i class="fa fa-images me-2"></i> Manage Carousel
    </a>
    <a href="@Url.Action("ManageProducts", "Admin")" class="offcanvas-link @( (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "ManageProducts" ? "active" : "")">
        <i class="fa fa-box-open me-2"></i> Manage Products
    </a>
}

@if (User.IsInRole("SuperAdmin"))
{
    <a href="@Url.Action("ViewComplaints", "Admin")" class="offcanvas-link @( (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "ViewComplaints" ? "active" : "")">
        <i class="fa fa-exclamation-circle me-2"></i> View Complaints
    </a>
}

<a href="@Url.Action("Logout", "Account")" class="offcanvas-link">
    <i class="fa fa-sign-out-alt me-2"></i> Logout
</a>