@model CoolCompanyEstore.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-info text-center mt-3">
        @TempData["SuccessMessage"]
    </div>
}

<div class="container my-5">
    <h2 class="mb-4">Checkout</h2>

    <div class="alert alert-info">
        This is a demo checkout page.<br />
        There is No Payment integration.
    </div>

    <form asp-action="Index" method="post">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control border rounded shadow-sm" placeholder="Enter your full name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ShippingAddress" class="form-label"></label>
            <input asp-for="ShippingAddress" class="form-control border rounded shadow-sm" placeholder="Enter your shipping address" />
            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control border rounded shadow-sm" placeholder="Enter your phone number" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="PaymentMethod" class="form-label">Payment Method</label>

            <select asp-for="PaymentMethod" class="form-select border rounded shadow-sm">
                <option value="">-- Select payment method --</option>
                <option>Credit Card</option>
                <option>Apple Pay</option>
                <option>STC Pay</option>
                <option>Mada</option>
            </select>

            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Place Order</button>

    </form>
</div>

<!-- هنا قسم الدفع بالصور -->
<div class="container py-4">
    <h4 class="text-dark mb-3">Payments</h4>
    <div class="footer-bank-card d-flex align-items-center flex-wrap">
        <a href="#" class="me-3 mb-2"><img src="~/img/apple-pay.jpg" alt="Apple Pay" width="50" height="30" /></a>
        <a href="#" class="me-3 mb-2"><img src="~/img/STC.jpg" alt="STC Pay" width="90" height="40" /></a>
        <a href="#" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" alt="Visa" width="50" height="30" /></a>
        <a href="#" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="MasterCard" width="50" height="30" /></a>
        <a href="#" class="me-3 mb-2"><img src="~/img/Mada.jpg" alt="Mada" width="60" height="45" /></a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
