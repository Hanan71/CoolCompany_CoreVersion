@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Dashboard";
    ViewData["Title"] = "Content Manager Dashboard Manage Users";
    Layout = "~/Views/Shared/_ContentLayout.cshtml";
}

<div class="content-header shadow-sm text-center">
    <h1>Welcome, Content Manager 🛠️</h1>
    <p class="mb-0">Here you can manage products, categories, and more!</p>
</div>

<!-- الصورة خارج الصندوق، وسط الصفحة -->
<div class="text-center mt-4">
    <img src="~/img/Admin_Content.gif" alt="Admin Content"
         style="max-width: 350px; height: auto; border-radius: 16px;
                box-shadow: 0 10px 20px rgba(0,0,0,0.2),
                            0 6px 6px rgba(0,0,0,0.19);
                transform: perspective(1000px) rotateX(5deg);"
         class="img-fluid" />
</div>

