<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-CoolCompanyEstore-be1af5c8-8bf7-4839-be83-21bb68816323</UserSecretsId>
  </PropertyGroup>

  <!-- إزالة ملفات ومجلدات غير مرغوب فيها من النشر -->
  <ItemGroup>
    <None Remove="Models\ViewModels\" />
    <None Remove="Views\Content\" />
    <None Remove="Views\Wishlist\" />
    <None Remove="Views\Checkout\" />
    <None Remove="Views\Order\" />
    <None Remove="Views\CarouselAdmin\" />
    <None Remove="Views\Shared\Components\" />
    <None Remove="Views\Shared\Components\AllowedPages\" />
    <None Remove="Areas\Filters\" />
    <None Remove="Views\Permissions\" />
  </ItemGroup>

  <!-- تضمين ملف قاعدة البيانات (إن وجد) -->
  <ItemGroup>
    <None Update="app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- الحزم والمكتبات المستخدمة -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="6.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="6.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="6.0.33">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="6.0.33" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="6.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="6.0.20" />
  </ItemGroup>

  <!-- المجلدات التي تريد تضمينها في المشروع -->
  <ItemGroup>
    <Folder Include="Views\Products\" />
    <Folder Include="wwwroot\update\" />
    <Folder Include="Views\Cart\" />
    <Folder Include="Views\Account\" />
    <Folder Include="Views\Admin\" />
    <Folder Include="Services\" />
    <Folder Include="Models\ViewModels\" />
    <Folder Include="Views\Content\" />
    <Folder Include="Views\Wishlist\" />
    <Folder Include="Views\Checkout\" />
    <Folder Include="Views\Order\" />
    <Folder Include="Views\CarouselAdmin\" />
    <Folder Include="Views\Shared\Components\" />
    <Folder Include="Views\Shared\Components\AllowedPages\" />
    <Folder Include="Areas\Filters\" />
    <Folder Include="Views\Permissions\" />
  </ItemGroup>

  <!-- إزالة محتويات محددة من النشر -->
  <ItemGroup>
    <Content Remove="wwwroot\update\" />
  </ItemGroup>

  <!-- تحديث ملف محدد ونسخه تلقائياً عند النشر -->
  <ItemGroup>
    <Content Update="wwwroot\permissions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- تضمين ملفات .cshtml للنشر -->
  <ItemGroup>
    <Content Update="**\*.cshtml">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
