@model List<CoolCompanyEstore.Models.Wishlist>

@{
    ViewData["Title"] = "My Wishlist";
}

@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["CartMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


    <div class="container my-5 page-padding-top">
    <h2 class="mb-4">My Wishlist</h2>

    @if (TempData["WishlistMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["WishlistMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="d-flex justify-content-center">
            <div class="alert alert-primary text-center p-3 rounded-3" style="max-width: 400px;">
                <div class="mb-2">Your wishlist is empty</div>
                <a href="/Products" class="btn btn-outline-primary d-inline-flex align-items-center">
                    <i class="fa fa-heart me-2"></i> Browse Now
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var product = item.Product;
                if (product != null)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">
                            @if (product.Images != null && product.Images.Any())
                            {
                                <div id="productCarousel-@product.Id" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        @{ var isFirst = true; }
                                        @foreach (var image in product.Images)
                                        {
                                            <div class="carousel-item @(isFirst ? "active" : "")">
                                                <img src="@Url.Content(image.ImagePath)" class="d-block w-100 card-img-top" style="height: 250px; object-fit: cover;" alt="@product.Name - Image">
                                            </div>
                                            isFirst = false;
                                        }
                                    </div>
                                    @if (product.Images.Count > 1)
                                    {
                                        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel-@product.Id" data-bs-slide="prev">
                                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Previous</span>
                                        </button>
                                        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel-@product.Id" data-bs-slide="next">
                                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                            <span class="visually-hidden">Next</span>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <img src="@Url.Content("/img/default-product.jpg")" alt="@product.Name" class="card-img-top" style="height: 250px; object-fit: cover;" />
                            }
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted">@product.Price.ToString("0.00") SAR</p>
                                <div class="mt-auto d-flex flex-wrap gap-2">
                                    <a href="@Url.Action("Details", "Products", new { id = product.Id })"
                                       class="btn btn-outline-primary btn-sm">
                                        View
                                    </a>
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm">Buy Now</button>
                                    </form>
                                    <form asp-action="Remove" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to remove this item?')">
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

