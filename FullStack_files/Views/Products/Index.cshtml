@model CoolCompanyEstore.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Products";
    var selectedCategory = Context.Request.Query["category"].ToString();
}

<div class="container-fluid products py-5 my-5 page-padding-top">
    <div class="mx-auto text-center mb-5" style="max-width: 900px;">
        <h5 class="section-title px-3">Our Products</h5>
        <h1 class="mb-4">Tech & Innovation Store.</h1>
        <p class="mb-0">
            Discover the latest in smart gadgets, tech accessories, and innovative solutions that power your lifestyle.
        </p>
    </div>

    <div class="tab-class text-center">
        <ul class="nav nav-pills d-inline-flex justify-content-center mb-5">
            <li class="nav-item">
                <a class="d-flex mx-2 py-2 border border-primary bg-light rounded-pill @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")"
                   href="@Url.Action("Index", "Products")">
                    <span class="text-dark" style="width: 150px;">All</span>
                </a>
            </li>

            @foreach (var cat in Model.Categories)
            {
                if (!string.IsNullOrWhiteSpace(cat.Name))
                {
                    <li class="nav-item">
                        <a class="d-flex mx-2 py-2 border border-primary bg-light rounded-pill @(selectedCategory == cat.Name ? "active" : "")"
                           href="@Url.Action("Index", "Products", new { category = cat.Name })">
                            <span class="text-dark" style="width: 150px;">@cat.Name</span>
                        </a>
                    </li>
                }
            }
        </ul>

        <div class="tab-content">
            <div id="ProductsTab-1" class="tab-pane fade show p-0 active">
                <div class="row g-3">
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        foreach (var product in Model.Products)
                        {
                            <div class="col-4 col-sm-4 col-md-4 col-lg-3">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">
                                    <div class="products-item h-100 position-relative border rounded shadow-sm p-3 zoom-effect">
                                        @if (product.Images != null && product.Images.Any())
                                        {
                                            <div id="productsCarousel-@product.Id" class="carousel slide" data-bs-ride="carousel">
                                                <div class="carousel-inner">
                                                    @{ var isFirst = true; }
                                                    @foreach (var image in product.Images)
                                                    {
                                                        <div class="carousel-item @(isFirst ? "active" : "")">
                                                            <img src="@Url.Content(image.ImagePath)" class="d-block w-100 rounded shadow-sm mb-3" style="object-fit: cover; max-height: 200px;" alt="@product.Name - Image">
                                                        </div>
                                                        isFirst = false;
                                                    }
                                                </div>
                                                @if (product.Images.Count > 1)
                                                {
                                                    <button class="carousel-control-prev" type="button" data-bs-target="#productsCarousel-@product.Id" data-bs-slide="prev">
                                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                        <span class="visually-hidden">Previous</span>
                                                    </button>
                                                    <button class="carousel-control-next" type="button" data-bs-target="#productsCarousel-@product.Id" data-bs-slide="next">
                                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                        <span class="visually-hidden">Next</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <img src="@Url.Content("/img/default-product.jpg")" class="img-fluid w-100 rounded shadow-sm mb-3" alt="@product.Name" style="object-fit: cover; max-height: 200px;" />
                                            </div>
                                        }

                                        <div class="products-content mt-2 px-2">
                                            <h5 class="text-dark">@product.Name</h5>
                                            <p class="text-muted mb-1">@product.Price.ToString("0.00") SAR</p>
                                            <div class="d-flex justify-content-center">
                                                <a asp-controller="Products"
                                                   asp-action="Details"
                                                   asp-route-id="@product.Id"
                                                   class="btn btn-sm btn-outline-primary shadow-sm"
                                                   onclick="event.stopPropagation();">
                                                    <i class="fa fa-info-circle"></i>
                                                </a>

                                                <form asp-controller="Wishlist"
                                                      asp-action="AddToWishlist"
                                                      method="post"
                                                      class="mx-1"
                                                      onclick="event.stopPropagation();">
                                                    <input type="hidden" name="productId" value="@product.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary shadow-sm">
                                                        <i class="fa fa-heart"></i>
                                                    </button>
                                                </form>

                                                <form asp-controller="Cart"
                                                      asp-action="AddToCartQuick"
                                                      method="post"
                                                      onclick="event.stopPropagation();">
                                                    <input type="hidden" name="productId" value="@product.Id" />
                                                    <input type="hidden" name="quantity" value="1" />
                                                    <input type="hidden" name="color" value="" />
                                                    <input type="hidden" name="size" value="" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success shadow-sm">
                                                        <i class="fa fa-cart-plus"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <p class="text-muted text-center">No products found for this category.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <h4 class="text-dark mb-3">Payments</h4>
    <div class="footer-bank-card d-flex align-items-center flex-wrap">
        <a href="#" class="me-3 mb-2"><img src="~/img/apple-pay.jpg" alt="Apple Pay" width="50" height="30" /></a>
        <a href="#" class="me-3 mb-2"><img src="~/img/STC.jpg" alt="STC Pay" width="90" height="40" /></a>
        <a href="#" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" alt="Visa" width="50" height="30" /></a>
        <a href="#" class="me-3 mb-2"><img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="MasterCard" width="50" height="30" /></a>
        <a href="#" class="me-3 mb-2"><img src="~/img/Mada.jpg" alt="Mada" width="60" height="45" /></a>
    </div>
</div>

