@model List<CoolCompanyEstore.Models.Order>

@{
    ViewData["Title"] = "Orders Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-info text-center">
        @TempData["SuccessMessage"]
    </div>
}

<div class="container mt-5">
    <h2 class="mb-4"> Review and Manage Customer Orders🛒</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No orders found.
        </div>
    }
    else
    {
        <div class="table-responsive shadow rounded d-none d-md-block">
            <table class="table table-hover table-bordered text-center align-middle mb-0">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.FullName</td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.TotalAmount.ToString("0.00") SAR</td>
                            <td>
                                <span class="badge @(order.Status switch {
                                    "Delivered" => "bg-success",
                                    "Processing" => "bg-warning text-dark",
                                    "Canceled" => "bg-danger",
                                    _ => "bg-secondary"
                                })">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Admin" asp-action="OrderProducts" asp-route-orderId="@order.Id" class="btn btn-sm btn-primary">View Products</a>
                                <a asp-controller="Admin" asp-action="ManageStatus" asp-route-id="@order.Id" class="btn btn-sm btn-secondary">Edit</a>
                                <form asp-controller="Admin" asp-action="DeleteOrder" asp-route-id="@order.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this order?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-md-none">
            @foreach (var order in Model)
            {
                <div class="card shadow border-0 mb-3">
                    <div class="card-body">
                        <h5 class="card-title text-primary">Order ID: @order.Id</h5>
                        <p class="card-text mb-1">
                            <strong>Customer:</strong> @order.FullName
                        </p>
                        <p class="card-text mb-1">
                            <strong>Date:</strong> @order.OrderDate.ToString("yyyy-MM-dd")
                        </p>
                        <p class="card-text mb-1">
                            <strong>Total:</strong> @order.TotalAmount.ToString("0.00") SAR
                        </p>
                        <p class="card-text mb-2">
                            <strong>Status:</strong>
                            <span class="badge @(order.Status switch {
                                "Delivered" => "bg-success",
                                "Processing" => "bg-warning text-dark",
                                "Canceled" => "bg-danger",
                                _ => "bg-secondary"
                            })">
                                @order.Status
                            </span>
                        </p>
                        <div class="d-grid gap-2">
                            <a asp-controller="Admin" asp-action="OrderProducts" asp-route-orderId="@order.Id" class="btn btn-sm btn-primary">View Products</a>
                            <a asp-controller="Admin" asp-action="ManageStatus" asp-route-id="@order.Id" class="btn btn-sm btn-secondary">Edit Status</a>
                            <form asp-controller="Admin" asp-action="DeleteOrder" asp-route-id="@order.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this order?');">
                                <button type="submit" class="btn btn-sm btn-danger w-100 mt-1">Delete Order</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="text-center mt-4">
    <a asp-controller="Admin" asp-action="SuperDashboard" class="btn btn-outline-primary">
        ← Back to Dashboard
    </a>
</div>
