@model List<CoolCompanyEstore.Models.Contact>

@{
    ViewData["Title"] = "Contact Submissions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="container mt-4">
    <h3>Contact Form Submissions</h3>

    <p class="ps-3 pt-3">✎ᝰ Total Number Of Messages: @Model.Count</p>

    <div class="table-responsive shadow rounded d-none d-md-block">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="table-secondary">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Message</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Message</td>
                        <td>@item.SubmittedAt.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none">
        @foreach (var item in Model)
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <h5 class="card-title text-primary">@item.Name</h5>
                    <p class="card-text">
                        <strong>Email:</strong> @item.Email<br />
                        <strong>Message:</strong> @item.Message<br />
                        <small class="text-muted"><strong>Date:</strong> @item.SubmittedAt.ToString("g")</small>
                    </p>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Admin" asp-action="SuperDashboard" class="btn btn-outline-primary">
            ← Back to Dashboard
        </a>
    </div>
</div>
