@model List<CoolCompanyEstore.Models.ApplicationUser>

@{
    ViewData["Title"] = "Deleted Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-danger">Deleted Users </h2>

    <div class="table-responsive shadow rounded d-none d-md-block">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="custom-gray-header">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>UserName</th>
                    <th>Deleted</th>
                    <th>Roles</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.PhoneNumber</td>
                        <td>@user.UserName</td>
                        <td>@(user.IsDeleted ? "Yes" : "No")</td>
                        <td>@string.Join(", ", user.Roles ?? new List<string>())</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-md-none">
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <div class="card shadow border-0 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@user.FullName</h5>
                        <p class="card-text mb-1">
                            <strong>Email:</strong> @user.Email<br>
                            <strong>Phone:</strong> @user.PhoneNumber<br>
                            <strong>Username:</strong> @user.UserName
                        </p>
                        <p class="card-text mb-1">
                            <strong>Deleted:</strong> @(user.IsDeleted ? "Yes" : "No")
                        </p>
                        <p class="card-text mb-0">
                            <strong>Roles:</strong> @string.Join(", ", user.Roles ?? new List<string>())
                        </p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info text-center">No deleted users found.</div>
        }
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Admin" asp-action="ManageUsers" class="btn btn-outline-primary">
            ← Back to Manage Users
        </a>
    </div>
</div>
