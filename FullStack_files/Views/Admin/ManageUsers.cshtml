
@model CoolCompanyEstore.ViewModels.UsersViewModel
@using CoolCompanyEstore.ViewModels

@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <h2 class="mb-4">👤 Manage Users</h2>

    <div class="mb-3 text-end">
        <a asp-controller="Admin" asp-action="DeletedUsers" class="btn btn-outline-danger">
            View Deleted Users
        </a>
    </div>

    <h4 class="mt-4 mb-2 text-primary d-none d-md-block">Admins with Roles</h4>
    <div class="table-responsive shadow rounded mb-5 d-none d-md-block">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="table-secondary">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Username</th>
                    <th>Roles</th>
                    <th style="min-width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.OtherUsers != null && Model.OtherUsers.Any())
                {
                    foreach (var user in Model.OtherUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.UserName</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-secondary me-1">@role</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/Admin/AssignRole?userId=@user.Id" class="btn btn-sm btn-warning">Assign Role</a>
                                    <form method="post" asp-action="DeleteUser" asp-controller="Admin"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');"
                                          style="display:inline;">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-muted">No other users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h4 class="mt-4 mb-2 text-primary d-md-none">Admins with Roles</h4>
    <div class="d-md-none">
        @if (Model.OtherUsers != null && Model.OtherUsers.Any())
        {
            foreach (var user in Model.OtherUsers)
            {
                <div class="card shadow border-0 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@user.FullName</h5>
                        <p class="card-text mb-1">
                            <strong>Email:</strong> @user.Email<br>
                            <strong>Phone:</strong> @user.PhoneNumber<br>
                            <strong>Username:</strong> @user.UserName
                        </p>
                        <p class="card-text mb-2">
                            <strong>Roles:</strong>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-secondary me-1">@role</span>
                            }
                        </p>
                        <hr />
                        <div class="d-grid gap-2">
                            <a href="/Admin/AssignRole?userId=@user.Id" class="btn btn-sm btn-warning w-100">Assign Role</a>
                            <form method="post" asp-action="DeleteUser" asp-controller="Admin"
                                  onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-danger w-100 mt-1">Delete User</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info text-center">No other users found.</div>
        }
    </div>

   

    <h4 class="mt-4 mb-2 text-primary d-none d-md-block">Normal Users (Customers)</h4>
    <div class="table-responsive shadow rounded d-none d-md-block">
        <table class="table table-hover table-bordered text-center align-middle mb-0">
            <thead class="table-secondary">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Username</th>
                    <th>Roles</th>
                    <th style="min-width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.NormalUsers != null && Model.NormalUsers.Any())
                {
                    foreach (var user in Model.NormalUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.UserName</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">

                                    <form method="post" asp-action="DeleteUser" asp-controller="Admin"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');"
                                          style="display:inline;">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-muted">No normal users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h4 class="mt-4 mb-2 text-primary d-md-none">Normal Users (Customers)</h4>
    <div class="d-md-none">
        @if (Model.NormalUsers != null && Model.NormalUsers.Any())
        {
            foreach (var user in Model.NormalUsers)
            {
                <div class="card shadow border-0 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@user.FullName</h5>
                        <p class="card-text mb-1">
                            <strong>Email:</strong> @user.Email<br>
                            <strong>Phone:</strong> @user.PhoneNumber<br>
                            <strong>Username:</strong> @user.UserName
                        </p>
                        <p class="card-text mb-2">
                            <strong>Roles:</strong>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                        </p>
                        <hr />
                        <div class="d-grid gap-2">

                            <form method="post" asp-action="DeleteUser" asp-controller="Admin"
                                  onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-danger w-100 mt-1">Delete User</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info text-center">No normal users found.</div>
        }
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Admin" asp-action="SuperDashboard" class="btn btn-outline-primary">
            ← Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>document.addEventListener("DOMContentLoaded", function () {
            const assignButtons = document.querySelectorAll(".assign-role-btn");

            assignButtons.forEach(button => {
                button.addEventListener("click", function (event) {
                    event.preventDefault(); // Prevent default link behavior
                    const userId = this.dataset.userId;
                    const username = this.dataset.username;

                    Swal.fire({
                        title: 'Are you sure?',
                        text: `Are you sure you want to assign a role to this Normal user (${username})?`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, assign role',
                        cancelButtonText: 'Cancel',
                        customClass: {
                            confirmButton: 'btn btn-danger me-2',
                            cancelButton: 'btn btn-secondary'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = `/Admin/AssignRole?userId=${userId}`;
                        }
                    });
                });
            });
        });</script>
}

