@{
    ViewData["Title"] = "Contact Us";
}

<!-- Contact Start -->
<div class="container-fluid contact bg-light py-5 page-padding-top">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 900px;">
            <h5 class="section-title px-3">Contact Us</h5>
            <h1 class="mb-0">Contact For Any Query</h1>
        </div>

        <div class="row g-5 align-items-center">
            <!-- Contact Info Column -->
            <div class="col-lg-4">
                <div class="bg-white rounded p-4 shadow">
                    <div class="text-center mb-4">
                        <i class="fa fa-map-marker-alt fa-3x text-primary"></i>
                        <h4 class="text-primary">Address</h4>
                        <p class="mb-0">Anas Ibn Malik Rd, <br> Riyadh, KSA</p>
                    </div>
                    <div class="text-center mb-4">
                        <i class="fa fa-phone-alt fa-3x text-primary mb-3"></i>
                        <h4 class="text-primary">Mobile</h4>
                        <p class="mb-0">+96655000000</p>
                    </div>
                    <div class="text-center">
                        <i class="fa fa-envelope-open fa-3x text-primary mb-3"></i>
                        <h4 class="text-primary">Email</h4>
                        <a href="mailto:info@coolcompany.com">info@eCoolCompany.com</a>
                    </div>
                </div>
            </div>
            <!-- Contact Form Column -->
            <div class="col-lg-8">
                <h3 class="mb-2">Send us a message</h3>
                <p class="mb-4">We’d love to hear from you. Fill out the form below.</p>

                <div class="bg-white shadow rounded p-4">
                    <form id="contactForm" asp-controller="Contact" asp-action="SubmitContact" method="post" class="mt-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input id="name" name="Name" type="text" class="form-control" placeholder="Your Name" required>
                                    <label for="name">Your Name</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input id="email" name="Email" type="email" class="form-control" placeholder="Your Email" required>
                                    <label for="email">Your Email</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea id="message" name="Message" class="form-control" placeholder="Leave a message here" style="height: 160px" required></textarea>
                                    <label for="message">Message</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100 py-3">Send Message</button>
                            </div>

                            <div class="col-12">
                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
                                        @TempData["Success"]
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>


            <!-- Map Column -->
            <div class="col-12" id="map">
                <div class="rounded">
                    <iframe class="rounded w-100" style="height: 450px;"
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3620.7736705576863!2d46.67854690000001!3d24.8374125!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e2ee44259d18acf%3A0x598b26bc1cf242e7!2z2KzZiNix2KfYoQ!5e0!3m2!1sar!2ssa!4v1751703207633!5m2!1sar!2ssa"
                            loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Contact End -->
