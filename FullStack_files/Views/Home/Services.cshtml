@{
    ViewData["Title"] = "Our Services";
}

<div class="container-fluid bg-light service py-5 page-padding-top">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 900px;">
            <h5 class="section-title px-3">Services</h5>
            <h1 class="mb-0">What We Offer</h1>
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 pe-0">
                            <div class="service-content text-end">
                                <h5 class="mb-4">Latest Electronics</h5>
                                <p class="mb-0">Explore the newest mobile devices, laptops, and accessories in the market.</p>
                            </div>
                            <div class="service-icon p-4">
                                <i class="fa fa-mobile-alt fa-4x text-primary"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 pe-0">
                            <div class="service-content text-end">
                                <h5 class="mb-4">Customer Support</h5>
                                <p class="mb-0">We're available to assist you through phone, WhatsApp, and chat 7 days a week.</p>
                            </div>
                            <div class="service-icon p-4">
                                <i class="fa fa-headset fa-4x text-primary"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 pe-0">
                            <div class="service-content text-end">
                                <h5 class="mb-4">Web Development</h5>
                                <p class="mb-0">We build fast, responsive, and modern websites tailored to your business goals.</p>
                            </div>
                            <div class="service-icon p-4">
                                <i class="fa fa-code fa-4x text-primary"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 pe-0">
                            <div class="service-content text-end">
                                <h5 class="mb-4">Secure Payment</h5>
                                <p class="mb-0">Enjoy multiple safe payment options including STC Pay, Mada, and Apple Pay.</p>
                            </div>
                            <div class="service-icon p-4">
                                <i class="fa fa-lock fa-4x text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 ps-0">
                            <div class="service-icon p-4">
                                <i class="fa fa-paint-brush fa-4x text-primary"></i>
                            </div>
                            <div class="service-content">
                                <h5 class="mb-4">UI/UX Design</h5>
                                <p class="mb-0">Our designers create beautiful and user-friendly interfaces to elevate your brand.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 ps-0">
                            <div class="service-icon p-4">
                                <i class="fa fa-comments fa-4x text-primary"></i>
                            </div>
                            <div class="service-content">
                                <h5 class="mb-4">Consulting</h5>
                                <p class="mb-0">We provide strategic advice to help you navigate the digital landscape successfully.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 ps-0">
                            <div class="service-icon p-4">
                                <i class="fa fa-truck fa-4x text-primary"></i>
                            </div>
                            <div class="service-content">
                                <h5 class="mb-4">Fast Delivery</h5>
                                <p class="mb-0">Quick shipping service across KSA, delivered within 1–3 days.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="service-content-inner d-flex align-items-center bg-white border border-primary rounded p-4 ps-0">
                            <div class="service-icon p-4">
                                <i class="fa fa-sync-alt fa-4x text-primary"></i>
                            </div>
                            <div class="service-content">
                                <h5 class="mb-4">Easy Returns</h5>
                                <p class="mb-0">Return any product within 7 days with our simple return policy.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="text-center">
                    <a class="btn btn-primary rounded-pill py-3 px-5 mt-2" href="#">Explore More</a>
                </div>
            </div>
        </div>
    </div>
</div>
