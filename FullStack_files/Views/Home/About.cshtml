@{
    ViewData["Title"] = "About";
}

<div class="container-fluid about py-5 page-padding-top">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5">
                <div class="h-100 position-relative" style="border: 50px solid; border-color: transparent #13357B transparent #13357B; border-radius: 100px;">

                    <video class="img-fluid w-100 h-100" controls autoplay muted loop>
                        <source src="@Url.Content("~/video/about-video.mp4")" type="video/mp4">
                        Your browser does not support video playback.
                    </video>


                </div>
            </div>

            <div class="col-lg-7" style="background: linear-gradient(rgba(255, 255, 255, .8), rgba(255, 255, 255, .8)), url('@Url.Content("~/img/about-img-2.jpg")');">
                <h5 class="section-about-title pe-3">About Us</h5>
                <h1 class="mb-4">Welcome to <span class="text-primary">Cool Company</span></h1>
                <p class="mb-4">
                    Welcome to Cool Company – your one-stop online store for high-quality, handpicked products. Whether you're looking for the latest trends, daily essentials, or exclusive deals, we've got something for everyone.
                </p>
                <p class="mb-4">
                    We’re committed to providing a seamless shopping experience with fast delivery, secure payments, and 24/7 support. Shop with confidence and enjoy the convenience of online shopping made simple.
                </p>

                <div class="row gy-2 gx-4 mb-4">
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Fast & Reliable Shipping</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Wide Range of Quality Products</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Easy Returns & Refunds</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Exclusive Deals & Discounts</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>Secure Payment Options</p>
                    </div>
                    <div class="col-sm-6">
                        <p class="mb-0"><i class="fa fa-arrow-right text-primary me-2"></i>24/7 Service</p>
                    </div>
                </div>
                <a class="btn btn-primary rounded-pill py-3 px-5 mt-2" href="/Home/Services">Read More</a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid guide py-5">
